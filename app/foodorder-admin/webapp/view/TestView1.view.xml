<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    controllerName="foodorderadmin.controller.OrderItems"
    height="100%"
>
    <uxap:ObjectPageLayout
        id="testorderObjectPage"
        enableLazyLoading="true"
        useIconTabBar="true"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false"
        isChildPage="true"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <Title
                        text="{orderNumber}"
                        wrapping="true"
                    />
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <FlexBox
                        fitContainer="true"
                        alignItems="Center"
                    >
                        <Title
                            text="{orderNumber}"
                            wrapping="true"
                        />
                    </FlexBox>
                </uxap:snappedHeading>
                <!-- <uxap:expandedContent>
                    <Text text="{description}" />
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <Text text="{description}" />
                </uxap:snappedContent> -->
                <uxap:actions>
                    <Button
                        text="Edit"
                        type="Emphasized"
                    />
                    <Button
                        text="Delete"
                        type="Transparent"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <FlexBox
                wrap="Wrap"
                fitContainer="true"
                alignItems="Start"
            >
                <Avatar
                    src="https://www.universalorlando.com/webdata/k2/en/gb/files/Images/gds/uor-usf-minion-land-pop-a-nana-minion-popcorn-b.jpg"
                    displaySize="XL"
                    displayShape="Square"
                    showBorder="true"
                    class="sapUiMediumMarginEnd"
                />
                <VBox class="sapUiTinyMarginTop sapUiMediumMarginEnd">
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Status:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <ObjectStatus
                            text="{status/name}"
                            state="{path: 'status/code', formatter: '.formatStatusState'}"
                            icon="{path: 'status/code', formatter: '.formatStatusIcon'}"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Buyer:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <Text
                            text="{buyer/buyerName}"
                            class="sapThemeText-asHeading6"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Date:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <Text
                            text="{
                                        path: 'orderDate',
                                        type: 'sap.ui.model.odata.type.Date'
                                    }"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Participants:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <ObjectNumber
                            number="{numberOfPeople}"
                            unit="people"
                        />
                    </HBox>
                </VBox>
                <VBox class="sapUiTinyMarginTop sapUiMediumMarginEnd">
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Delivery Fee:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <ObjectNumber
                            core:require="{Currency: 'sap/ui/model/type/Currency'}"
                            number="{
                                    parts:[
                                        {path:'deliveryFee'},
                                        {path:'currency_code'}
                                    ],
                                    type: 'Currency',
                                    formatOptions: {showMeasure: false}
                                }"
                            unit="{currency_code}"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Discount:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <ObjectNumber
                            number="{discountPercent}"
                            unit="%"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Extra Charges:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <ObjectNumber
                            core:require="{Currency: 'sap/ui/model/type/Currency'}"
                            number="{
                                    parts:[
                                        {path:'extraCharges'},
                                        {path:'currency_code'}
                                    ],
                                    type: 'Currency',
                                    formatOptions: {showMeasure: false}
                                }"
                            unit="{currency_code}"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Total Amount:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                        <ObjectNumber
                            core:require="{Currency: 'sap/ui/model/type/Currency'}"
                            number="{
                                    parts:[
                                        {path:'totalAmount'},
                                        {path:'currency_code'}
                                    ],
                                    type: 'Currency',
                                    formatOptions: {showMeasure: false}
                                }"
                            unit="{currency_code}"
                        />
                    </HBox>
                </VBox>
                <VBox class="sapUiTinyMarginTop sapUiMediumMarginEnd">
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Label
                            text="Description:"
                            class="sapUiTinyMarginEnd orderLabel"
                        />
                    </HBox>
                    <HBox
                        alignItems="Start"
                        class="sapUiTinyMarginBottom"
                    >
                        <Text text="{description}" />
                    </HBox>
                </VBox>
            </FlexBox>
        </uxap:headerContent>

        <uxap:ObjectPageSection
            title="Order Items"
            titleUppercase="false"
        >
            <uxap:subSections>
                <uxap:ObjectPageSubSection>
                    <table:Table
                        id="testorderItemsTable"
                        rows="{
                                    path: 'items',
                                    parameters: {
                                        expand: 'itemStatus',
                                        select: 'ID,customerName,menuItemName,quantity,unitPrice,deliveryFee,discountPercent,discountAmount,overchargeAmount,itemTotal,isConfirmed,specialRequest,currency_code,itemStatus'
                                    }
                                }"
                        selectionMode="MultiToggle"
                        enableSelectAll="true"
                        firstVisibleRow="0"
                        enableColumnReordering="true"
                        enableColumnFreeze="true"
                        showNoData="true"
                    >
                        <table:extension>
                            <Toolbar>
                                <ToolbarSpacer />
                                <Button
                                    text="Add Item"
                                    press="onAddItem"
                                    type="Emphasized"
                                />
                                <Button
                                    text="Delete Selected"
                                    press="onDeleteSelected"
                                    type="Transparent"
                                />
                            </Toolbar>
                        </table:extension>
                        <table:columns>
                            <table:Column
                                autoResizable="true"
                                sortProperty="customerName"
                                filterProperty="customerName"
                            >
                                <Label text="Customer Name" />
                                <table:template>
                                    <Text
                                        text="{customerName}"
                                        wrapping="false"
                                    />
                                </table:template>
                            </table:Column>
                            <table:Column
                                autoResizable="true"
                                sortProperty="menuItemName"
                                filterProperty="menuItemName"
                            >
                                <Label text="Menu Item" />
                                <table:template>
                                    <Text
                                        text="{menuItemName}"
                                        wrapping="false"
                                    />
                                </table:template>
                            </table:Column>
                            <table:Column
                                autoResizable="true"
                                sortProperty="quantity"
                                filterProperty="quantity"
                                hAlign="End"
                            >
                                <Label text="Quantity" />
                                <table:template>
                                    <ObjectNumber
                                        number="{quantity}"
                                        unit="PC"
                                    />
                                </table:template>
                            </table:Column>

                            <table:Column
                                autoResizable="true"
                                sortProperty="unitPrice"
                                filterProperty="unitPrice"
                                hAlign="End"
                            >
                                <Label text="Unit Price" />
                                <table:template>
                                    <Text text="{unitPrice} {currency_code}" />
                                </table:template>
                            </table:Column>
                            <table:Column
                                autoResizable="true"
                                sortProperty="itemTotal"
                                filterProperty="itemTotal"
                                hAlign="End"
                            >
                                <Label text="Item Total" />
                                <table:template>
                                    <ObjectNumber
                                        core:require="{Currency: 'sap/ui/model/type/Currency'}"
                                        number="{
                                                parts:[
                                                    {path:'itemTotal'},
                                                    {path:'currency_code'}
                                                ],
                                                type: 'Currency',
                                                formatOptions: {showMeasure: false}
                                            }"
                                        unit="{currency_code}"
                                    />
                                </table:template>
                            </table:Column>
                            <table:Column
                                autoResizable="true"
                                sortProperty="itemStatus/name"
                                filterProperty="itemStatus/name"
                            >
                                <Label text="Status" />
                                <table:template>
                                    <ObjectStatus
                                        text="{itemStatus/name}"
                                        state="{path: 'itemStatus/code', formatter: '.formatStatusState'}"
                                        icon="{path: 'itemStatus/code', formatter: '.formatStatusIcon'}"
                                    />
                                </table:template>
                            </table:Column>
                        </table:columns>
                    </table:Table>
                </uxap:ObjectPageSubSection>
            </uxap:subSections>
        </uxap:ObjectPageSection>
    </uxap:ObjectPageLayout>
</mvc:View>
