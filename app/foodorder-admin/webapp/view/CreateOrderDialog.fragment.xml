<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog 
        id="createOrderDialog" 
        title="Create New Order" 
        contentWidth="500px" 
        contentHeight="600px"
        resizable="true"
        draggable="true">
        <content>
            <f:SimpleForm
                layout="ResponsiveGridLayout"
                editable="true"
                columnsL="1"
                columnsM="1"
                class="sapUiResponsiveMargin">
                
                <f:content>
                    <!-- Buyer Information -->
                    <Label text="Buyer Information" class="sapUiMediumMarginTop" />
                    
                    <Label text="Buyer Name:" />
                    <Input id="buyerNameInput" value="" placeholder="Enter buyer name" required="true" />
                    
                    <Label text="Employee ID:" />
                    <Input id="buyerEmpIdInput" value="" placeholder="Enter employee ID" />
                    
                    <Label text="Contact Number:" />
                    <Input id="buyerContactInput" value="" placeholder="Enter contact number" />
                    
                    <!-- Order Details -->
                    <Label text="Order Details" class="sapUiMediumMarginTop" />
                    
                    <Label text="Order Date:" />
                    <DatePicker id="orderDatePicker" value="" placeholder="Select order date" required="true" />
                    
                    <Label text="Order Time:" />
                    <TimePicker id="orderTimePicker" value="" placeholder="Select order time" required="true" />
                    
                    <Label text="Number of People:" />
                    <Input id="numberOfPeopleInput" value="" type="Number" placeholder="Enter number of people" required="true" />
                    
                    <Label text="Delivery Fee:" />
                    <Input id="deliveryFeeInput" value="0" type="Number" placeholder="Enter delivery fee" />
                    
                    <Label text="Discount (%):" />
                    <Input id="discountPercentInput" value="0" type="Number" placeholder="Enter discount percentage" />
                    
                    <Label text="Currency:" />
                    <ComboBox id="currencyComboBox" selectedKey="IDR">
                        <core:Item key="IDR" text="IDR - Indonesian Rupiah" />
                        <core:Item key="USD" text="USD - US Dollar" />
                        <core:Item key="EUR" text="EUR - Euro" />
                    </ComboBox>
                    
                    <Label text="Status:" />
                    <ComboBox id="statusComboBox" selectedKey="O">
                        <core:Item key="O" text="Open" />
                        <core:Item key="P" text="Processing" />
                        <core:Item key="C" text="Closed" />
                    </ComboBox>
                </f:content>
            </f:SimpleForm>
        </content>
        <buttons>
            <Button text="Create Order" type="Emphasized" press="onConfirmCreateOrder" />
            <Button text="Cancel" press="onCancelCreateOrder" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>