{
  "_version": "1.65.0",
  "sap.app": {
    "id": "foodorderadmin",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.17.4",
      "toolsId": "7bafe52c-af9c-458f-88cd-65161a2faaa7"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/lunchy/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "foodorderadmin-manage": {
          "semanticObject": "foodorderadmin",
          "action": "manage",
          "title": "{{foodorderadmin-manage.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.uxap": {},
        "sap.ui.comp": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "foodorderadmin.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "foodorderadmin.view",
        "async": true,
        "viewPath": "foodorderadmin.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        },
        {
          "pattern": "order({orderId}):?query:",
          "name": "orderItems",
          "target": "TargetOrderItems"
        }
      ],
      "targets": {
        "TargetView1": {
          "viewType": "XML",
          "id": "View1",
          "name": "View1"
        },
        "TargetOrderItems": {
          "viewType": "XML",
          "id": "orderItems",
          "name": "OrderItems"
        }
      }
    },
    "rootView": {
      "viewName": "foodorderadmin.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}